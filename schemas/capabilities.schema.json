{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/iec60870-5-interop/schemas/capabilities.schema.json",
  "title": "iec60870-5-interop capability document",
  "description": "Output of 'print-capabilities'. See docs/CAPABILITIES.md.",
  "type": "object",
  "required": ["schemaVersion", "adapter", "adapterVersion", "protocol", "standard", "upstream", "roles", "features",
               "pointTypes", "commandTypes", "clientOperations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "adapter": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "protocol": { "enum": ["iec60870-5-101", "iec60870-5-102", "iec60870-5-103", "iec60870-5-104"], "description": "Same value as standard (contract 1.x name, kept)." },
    "standard": { "enum": ["iec60870-5-101", "iec60870-5-102", "iec60870-5-103", "iec60870-5-104"] },
    "transport": { "enum": ["tcp-stream"], "description": "IEC 101/102/103: the FT 1.2 byte stream over one TCP connection." },
    "linkModes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["unbalanced", "balanced"] } },
    "upstream": {
      "type": "object",
      "required": ["name", "version", "revision", "license", "language", "independentEngine"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "revision": { "type": "string" },
        "license": { "type": "string" },
        "language": { "type": "string" },
        "independentEngine": { "type": "boolean" },
        "engine": {
          "description": "The protocol engine, when the upstream is a layer over another project.",
          "type": "object",
          "required": ["name", "version", "license"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "license": { "type": "string" }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "required": ["server", "client"],
      "properties": { "server": { "type": "boolean" }, "client": { "type": "boolean" } }
    },
    "features": {
      "type": "object",
      "required": ["generalInterrogation", "groupInterrogation", "counterInterrogation", "read", "clockSync",
                   "testCommand", "directCommands", "selectBeforeOperate", "commandDeactivation",
                   "timeTaggedCommands", "spontaneousOnCommand", "apciParameters", "multipleConnections",
                   "pointQualityOnBitstring", "tls", "tlsServer", "tlsClient", "dataTransferEvents", "fileTransfer", "fileServer",
                   "fileClient", "fileUploadServer", "fileUploadClient", "fileDirectoryServer", "fileDirectoryClient",
                   "redundancyServer", "redundancyClient", "secureAuthentication"],
      "additionalProperties": { "type": "boolean" }
    },
    "pointTypes": { "type": "array", "items": { "type": "string", "pattern": "^M_[A-Z]{2}_[A-Z]{2}_1$" } },
    "commandTypes": { "type": "array", "items": { "type": "string", "pattern": "^C_[A-Z]{2}_[A-Z]{2}_1$" } },
    "clientOperations": { "type": "array", "items": { "type": "string" } }
  }
}
