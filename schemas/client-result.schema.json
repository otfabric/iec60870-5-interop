{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/iec60870-5-interop/schemas/client-result.schema.json",
  "title": "iec60870-5-interop client result document",
  "description": "The single line a 'client' operation prints. See docs/CONTAINER_CONTRACT.md.",
  "type": "object",
  "required": ["schemaVersion", "adapter", "operation", "ok", "error", "connected",
               "confirmations", "terminated", "asdus", "elapsedMs"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "adapter": { "type": "string" },
    "operation": {
      "enum": ["connect", "interrogate", "counter-interrogate", "read", "clock-sync", "test-command", "command",
               "monitor", "file-get", "file-put", "file-dir", "redundancy",
               "read-totals", "read-time", "set-time", "read-product", "read-tariff",
               "generic-read", "generic-write", "disturbance-list", "disturbance-transfer"]
    },
    "ok": { "type": "boolean" },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": ["connect-failed", "startdt-timeout", "stopdt-timeout", "link-init-timeout", "timeout", "negative-confirmation",
                       "connection-lost", "security-failed", "tls-failed", "login-refused", "failed"]
            },
            "message": { "type": "string" }
          }
        }
      ]
    },
    "connected": { "type": "boolean" },
    "startdtConfirmed": { "type": "boolean" },
    "stopdtConfirmed": { "type": "boolean" },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cot", "negative"],
        "properties": {
          "cot": {
            "description": "IEC 101/104: 7, 9, 17, 44..47. IEC 102: 7 and the refusals 13..18. IEC 103: 8 (clock synchronization), 20 and 21 (general command), 40 to 43 (generic services, contract 2.3).",
            "enum": [7, 8, 9, 13, 14, 15, 16, 17, 18, 20, 21, 40, 41, 42, 43, 44, 45, 46, 47]
          },
          "negative": { "type": "boolean" }
        }
      }
    },
    "terminated": { "type": "boolean" },
    "session": {
      "description": "IEC 102 with --profile ree: the session start (C_AC_NA_2) and end (C_FS_NA_2) were confirmed.",
      "type": "object",
      "required": ["login", "logout"],
      "additionalProperties": false,
      "properties": { "login": { "type": "boolean" }, "logout": { "type": "boolean" } }
    },
    "secured": { "description": "With --secure only: the association was established.", "type": "boolean" },
    "tls": { "description": "With --tls only: STARTDT con arrived over the TLS session.", "type": "boolean" },
    "file": {
      "description": "file-get and file-put only: what was transferred.",
      "type": "object",
      "required": ["ioa", "name", "length", "received", "sections", "sha256"],
      "properties": {
        "ioa": { "type": "integer", "minimum": 1, "maximum": 16777215 },
        "name": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "length": { "type": "integer", "minimum": 0 },
        "received": { "type": "integer", "minimum": 0 },
        "sections": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "redundancy": {
      "description": "redundancy only: what each connection saw.",
      "type": "object",
      "required": ["switchover", "primaryAsdus", "standbyAsdus", "strayAsdus", "queuedEvent"],
      "properties": {
        "switchover": { "enum": ["stopdt", "takeover"] },
        "primaryAsdus": { "type": "integer", "minimum": 0 },
        "standbyAsdus": { "type": "integer", "minimum": 0 },
        "strayAsdus": { "type": "integer", "minimum": 0 },
        "queuedEvent": { "type": "boolean" }
      }
    },
    "directory": {
      "description": "file-dir only: the entries received, in order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ioa", "nof", "lof", "sof"],
        "properties": {
          "ioa": { "type": "integer", "minimum": 0, "maximum": 16777215 },
          "nof": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "lof": { "type": "integer", "minimum": 0 },
          "sof": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "generic": {
      "description": "IEC 103 generic-read and generic-write (contract 2.3): the cause of the answer and its data sets.",
      "type": "object",
      "required": ["cot", "sets"],
      "properties": {
        "cot": { "type": "integer", "minimum": 0, "maximum": 255 },
        "sets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gin", "kod", "type", "size", "number"],
            "properties": {
              "gin": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$" },
              "kod": { "type": "integer", "minimum": 0, "maximum": 255 },
              "type": { "type": "integer", "minimum": 0, "maximum": 255 },
              "size": { "type": "integer", "minimum": 0, "maximum": 255 },
              "number": { "type": "integer", "minimum": 0, "maximum": 127 },
              "values": { "type": "array", "items": { "type": ["string", "number"] } },
              "data": { "type": "string", "pattern": "^([0-9a-f]{2})*$" }
            }
          }
        }
      }
    },
    "disturbances": {
      "description": "IEC 103 disturbance-list (contract 2.3): the faults of the ASDU 23.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fan", "sof", "time"],
        "properties": {
          "fan": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "sof": {
            "type": "object",
            "required": ["tp", "tm", "test", "otev"],
            "properties": { "tp": { "type": "boolean" }, "tm": { "type": "boolean" }, "test": { "type": "boolean" }, "otev": { "type": "boolean" } }
          },
          "time": { "type": "string" }
        }
      }
    },
    "disturbance": {
      "description": "IEC 103 disturbance-transfer (contract 2.3): the transferred record; null where the library does not report a field.",
      "type": "object",
      "required": ["fan", "tov", "nof", "noc", "noe", "interval", "start", "tags", "channels"],
      "properties": {
        "fan": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "tov": { "type": ["integer", "null"] },
        "nof": { "type": ["integer", "null"] },
        "noc": { "type": "integer", "minimum": 0, "maximum": 255 },
        "noe": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "interval": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "start": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$" },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pos", "fun", "inf", "dpi"],
            "properties": {
              "pos": { "type": ["integer", "null"] },
              "fun": { "type": "integer" }, "inf": { "type": "integer" }, "dpi": { "type": "integer" }
            }
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["acc", "rpv", "rsv", "rfa", "values"],
            "properties": {
              "acc": { "type": "integer" }, "rpv": { "type": "number" }, "rsv": { "type": "number" }, "rfa": { "type": "number" },
              "values": { "type": "array", "items": { "type": "integer" } }
            }
          }
        }
      }
    },
    "asdus": { "type": "array", "items": { "$ref": "#/$defs/asdu" } },
    "elapsedMs": { "type": "number", "minimum": 0 }
  },
  "allOf": [
    { "if": { "properties": { "operation": { "enum": ["file-get", "file-put"] } } }, "then": { "required": ["file"] } },
    { "if": { "properties": { "operation": { "const": "file-dir" } } }, "then": { "required": ["directory"] } },
    { "if": { "properties": { "operation": { "const": "redundancy" } } }, "then": { "required": ["redundancy"] } },
    { "if": { "properties": { "ok": { "const": true } } }, "then": { "properties": { "error": { "type": "null" } } },
      "else": { "properties": { "error": { "type": "object" } } } }
  ],
  "$defs": {
    "localTimeA": {
      "description": "IEC 102: time a, the station's local time to the minute, without a zone.",
      "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"
    },
    "asdu": {
      "type": "object",
      "required": ["type", "typeId", "cot", "negative", "test", "originator", "commonAddress", "sequence", "count",
                   "objects"],
      "properties": {
        "type": { "type": ["string", "null"] },
        "typeId": { "type": "integer", "minimum": 0, "maximum": 255 },
        "cot": {
          "description": "IEC 101/104: the cause, 6 bits. IEC 103: the cause of transmission octet, which has no P/N or T bit.",
          "type": "integer", "minimum": 0, "maximum": 255
        },
        "negative": { "type": "boolean" },
        "test": { "type": "boolean" },
        "originator": { "type": "integer", "minimum": 0, "maximum": 255 },
        "commonAddress": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "record": { "type": "integer", "minimum": 0, "maximum": 255, "description": "IEC 102: the record address" },
        "time": { "$ref": "#/$defs/localTimeA", "description": "IEC 102 integrated totals: the common time tag (time a), the end of the period" },
        "su": { "type": "boolean", "description": "IEC 102: the summer time bit of time" },
        "timeInvalid": { "type": "boolean", "description": "IEC 102: the IV bit of time" },
        "data": { "type": "string", "pattern": "^([0-9a-f]{2})*$", "description": "IEC 102: the octets after the record address of a type the adapter does not model" },
        "sequence": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 0, "maximum": 127 },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "IEC 101/104: an information object, by its address. IEC 103: the information object of the ASDU, by function type and information number.",
            "anyOf": [{ "required": ["ioa"] }, { "required": ["fun", "inf"] },
                      { "required": ["address"] }, { "required": ["time", "su"] }, { "required": ["standard", "manufacturer", "product"] },
                      { "required": ["first", "last", "from", "to"] }, { "required": ["from", "to"] }],
            "properties": {
              "ioa": { "type": "integer", "minimum": 0, "maximum": 16777215 },
              "value": { "type": ["boolean", "number"] },
              "normalized": { "type": "number" },
              "quality": {
                "description": "IEC 101/104: the flags. IEC 102: the quality descriptor octet as received.",
                "oneOf": [
                  { "type": "array", "items": { "enum": ["OV", "BL", "SB", "NT", "IV", "CY", "CA"] } },
                  { "type": "integer", "minimum": 0, "maximum": 255 }
                ]
              },
              "transient": { "type": "boolean" },
              "sequence": { "type": "integer" },
              "select": { "type": "boolean" },
              "qualifier": { "type": "integer" },
              "time": {
                "description": "IEC 101/104: CP56Time2a in UTC. IEC 102: time b, the station's local time without a zone.",
                "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z?$"
              },
              "su": { "type": "boolean", "description": "IEC 102: the summer time bit of time" },
              "address": { "type": "integer", "minimum": 0, "maximum": 255, "description": "IEC 102: the address of an integrated total or a tariff record" },
              "standard": { "type": "integer", "minimum": 0, "maximum": 255 },
              "manufacturer": { "type": "integer", "minimum": 0, "maximum": 255 },
              "product": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "first": { "type": "integer", "minimum": 0, "maximum": 255 },
              "last": { "type": "integer", "minimum": 0, "maximum": 255 },
              "from": { "$ref": "#/$defs/localTimeA" },
              "to": { "$ref": "#/$defs/localTimeA" },
              "maxPowerTime": { "$ref": "#/$defs/localTimeA" },
              "periodStart": { "$ref": "#/$defs/localTimeA" },
              "periodEnd": { "$ref": "#/$defs/localTimeA" },
              "timeInvalid": { "type": "boolean" },
              "qoi": { "type": "integer" },
              "qcc": { "type": "integer" },
              "counter": { "type": "integer" },
              "fbp": { "type": ["integer", "null"], "description": "C_TS_NA_1: the fixed test bit pattern, 21930 (55AA); null when the library only says it is not that." },
              "coi": { "type": "integer" },
              "nof": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "nos": { "type": "integer", "minimum": 0, "maximum": 255 },
              "lof": { "type": "integer", "minimum": 0, "maximum": 16777215 },
              "frq": { "type": "integer", "minimum": 0, "maximum": 255 },
              "srq": { "type": "integer", "minimum": 0, "maximum": 255 },
              "scq": { "type": "integer", "minimum": 0, "maximum": 255 },
              "lsq": { "type": "integer", "minimum": 0, "maximum": 255 },
              "chs": { "type": "integer", "minimum": 0, "maximum": 255 },
              "afq": { "type": "integer", "minimum": 0, "maximum": 255 },
              "data": {
                "description": "F_SG_NA_1: the segment. IEC 103: the information elements the adapter does not decode, or whose length is not the standard's.",
                "type": "string", "pattern": "^([0-9a-f]{2})*$"
              },
              "fun": { "type": "integer", "minimum": 0, "maximum": 255, "description": "IEC 103: function type" },
              "inf": { "type": "integer", "minimum": 0, "maximum": 255, "description": "IEC 103: information number" },
              "dpi": { "type": "integer", "minimum": 0, "maximum": 3 },
              "sin": { "type": "integer", "minimum": 0, "maximum": 255, "description": "IEC 103: supplementary information" },
              "ret": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "fan": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "scl": { "type": "number" },
              "time32": {
                "description": "IEC 103: CP32Time2a, which has no date.",
                "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["value", "ov", "er"],
                  "additionalProperties": false,
                  "properties": {
                    "value": { "type": "integer", "minimum": -4096, "maximum": 4095 },
                    "ov": { "type": "boolean" },
                    "er": { "type": "boolean" }
                  }
                }
              },
              "col": { "type": "integer", "minimum": 0, "maximum": 255 },
              "ascii": { "type": "string" },
              "software": { "type": "string", "pattern": "^([0-9a-f]{2}){4}$" },
              "scn": { "type": "integer", "minimum": 0, "maximum": 255 },
              "dco": { "type": "integer", "minimum": 0, "maximum": 255 },
              "rii": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        }
      }
    }
  }
}
