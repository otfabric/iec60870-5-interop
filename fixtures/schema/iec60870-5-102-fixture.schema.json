{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/iec60870-5-interop/fixtures/schema/iec60870-5-102-fixture.schema.json",
  "title": "iec60870-5-interop IEC 60870-5-102 fixture",
  "description": "A simulated IEC 102 integrated total station (an electricity meter, the secondary station). See docs/FIXTURES.md, IEC 102.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "station", "totals"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string" },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commonAddress", "accessKey", "clock", "product"],
      "properties": {
        "commonAddress": { "type": "integer", "minimum": 0, "maximum": 65534, "description": "The measuring point address (common address of ASDU)" },
        "accessKey": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "REE profile: the access key of C_AC_NA_2" },
        "clock": { "$ref": "#/$defs/timeB", "description": "The station's clock, which stands still until set-time sets it" },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standard", "manufacturer", "product"],
          "properties": {
            "standard": { "$ref": "#/$defs/octet" },
            "manufacturer": { "$ref": "#/$defs/octet" },
            "product": { "$ref": "#/$defs/u32" }
          }
        }
      }
    },
    "totals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record", "kind", "periods"],
        "properties": {
          "record": { "$ref": "#/$defs/octet" },
          "kind": { "enum": ["absolute", "incremental"], "description": "absolute: operational integrated totals, M_IT_TG_2 (C_CI_NT_2); incremental: periodically reset, M_IT_TK_2 (C_CI_NU_2)" },
          "periods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["end", "totals"],
              "properties": {
                "end": { "$ref": "#/$defs/timeA" },
                "totals": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["address", "value", "quality"],
                    "properties": {
                      "address": { "type": "integer", "minimum": 1, "maximum": 255 },
                      "value": { "$ref": "#/$defs/u32" },
                      "quality": { "$ref": "#/$defs/octet" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tariffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["register", "current", "stored"],
        "properties": {
          "register": { "type": "integer", "minimum": 134, "maximum": 139 },
          "current": { "type": "array", "items": { "$ref": "#/$defs/tariffRecord" } },
          "stored": { "type": "array", "items": { "$ref": "#/$defs/tariffRecord" } }
        }
      }
    }
  },
  "$defs": {
    "octet": { "type": "integer", "minimum": 0, "maximum": 255 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "timeA": {
      "description": "Time a (CP40Time2a): the station's local time to the minute, standard time (SU 0)",
      "type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]$"
    },
    "timeB": {
      "description": "Time b (CP56Time2b): the station's local time to the millisecond, standard time (SU 0)",
      "type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}$"
    },
    "tariffRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "activeAbs", "activeInc", "activeQuality", "reactiveIndAbs", "reactiveIndInc",
                   "reactiveIndQuality", "reactiveCapAbs", "reactiveCapInc", "reactiveCapQuality", "maxPower",
                   "maxPowerTime", "maxPowerQuality", "excessPower", "excessPowerQuality", "periodStart", "periodEnd"],
      "properties": {
        "address": { "$ref": "#/$defs/octet" },
        "activeAbs": { "$ref": "#/$defs/u32" },
        "activeInc": { "$ref": "#/$defs/u32" },
        "activeQuality": { "$ref": "#/$defs/octet" },
        "reactiveIndAbs": { "$ref": "#/$defs/u32" },
        "reactiveIndInc": { "$ref": "#/$defs/u32" },
        "reactiveIndQuality": { "$ref": "#/$defs/octet" },
        "reactiveCapAbs": { "$ref": "#/$defs/u32" },
        "reactiveCapInc": { "$ref": "#/$defs/u32" },
        "reactiveCapQuality": { "$ref": "#/$defs/octet" },
        "maxPower": { "$ref": "#/$defs/u32" },
        "maxPowerTime": { "$ref": "#/$defs/timeA" },
        "maxPowerQuality": { "$ref": "#/$defs/octet" },
        "excessPower": { "$ref": "#/$defs/u32" },
        "excessPowerQuality": { "$ref": "#/$defs/octet" },
        "periodStart": { "$ref": "#/$defs/timeA" },
        "periodEnd": { "$ref": "#/$defs/timeA" }
      }
    }
  }
}
