{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/iec60870-5-interop/fixtures/schema/iec60870-5-103-fixture.schema.json",
  "title": "iec60870-5-interop IEC 60870-5-103 fixture",
  "description": "A simulated IEC 103 protection device (the secondary station). See docs/FIXTURES.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "station", "indications"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string" },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commonAddress", "identification"],
      "properties": {
        "commonAddress": { "type": "integer", "minimum": 0, "maximum": 254 },
        "identification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fun", "col", "ascii", "software"],
          "properties": {
            "fun": { "$ref": "#/$defs/octet" },
            "col": { "$ref": "#/$defs/octet" },
            "ascii": { "type": "string", "pattern": "^[\\x20-\\x7e]{8}$" },
            "software": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
          }
        }
      }
    },
    "indications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fun", "inf", "dpi"],
        "properties": {
          "fun": { "$ref": "#/$defs/fun" },
          "inf": { "$ref": "#/$defs/octet" },
          "dpi": { "type": "integer", "minimum": 0, "maximum": 3 },
          "gi": { "type": "boolean" }
        }
      }
    },
    "measurands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fun", "inf", "type", "values"],
        "properties": {
          "fun": { "$ref": "#/$defs/fun" },
          "inf": { "$ref": "#/$defs/octet" },
          "type": { "enum": [3, 9] },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 9,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {
                "value": { "type": "integer", "minimum": -4096, "maximum": 4095 },
                "ov": { "type": "boolean" },
                "er": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fun", "inf"],
        "properties": {
          "fun": { "$ref": "#/$defs/fun" },
          "inf": { "$ref": "#/$defs/octet" }
        }
      }
    },
    "generic": {
      "description": "Generic data (clause 7.4.8): entries of single values, read with ASDU 21 and written with ASDU 10.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gin", "description", "type", "size", "value"],
        "properties": {
          "gin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "entry"],
            "properties": {
              "group": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "entry": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            }
          },
          "description": {
            "type": "string",
            "pattern": "^[\\x20-\\x7e]{1,32}$"
          },
          "type": {
            "description": "DATATYPE of the GDD: 1 ASCII, 3 unsigned integer, 4 integer, 7 R32.23",
            "enum": [1, 3, 4, 7]
          },
          "size": {
            "description": "DATASIZE in octets: the length of the text (type 1), 1, 2 or 4 (types 3, 4), 4 (type 7)",
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "value": {
            "description": "A string (type 1) or a number"
          },
          "writable": {
            "type": "boolean"
          }
        }
      }
    },
    "disturbances": {
      "description": "Recorded disturbances (clause 7.4.7), at most eight (ASDU 23).",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fan", "time", "nof", "interval", "start", "tags", "channels"],
        "properties": {
          "fan": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "sof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tp": {
                "type": "boolean"
              },
              "tm": {
                "type": "boolean"
              },
              "test": {
                "type": "boolean"
              },
              "otev": {
                "type": "boolean"
              }
            }
          },
          "time": {
            "description": "Time of the fault, CP56Time2a of ASDU 23",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "nof": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "interval": {
            "description": "INT, µs between two values",
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "start": {
            "description": "Time of the first value, CP32Time2a of ASDU 26",
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pos", "fun", "inf", "dpi"],
              "properties": {
                "pos": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "fun": {
                  "$ref": "#/$defs/fun"
                },
                "inf": {
                  "$ref": "#/$defs/octet"
                },
                "dpi": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            }
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["acc", "rpv", "rsv", "rfa", "values"],
              "properties": {
                "acc": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                },
                "rpv": {
                  "type": "number"
                },
                "rsv": {
                  "type": "number"
                },
                "rfa": {
                  "type": "number"
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 65535,
                  "items": {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "octet": { "type": "integer", "minimum": 0, "maximum": 255 },
    "fun": { "type": "integer", "minimum": 0, "maximum": 254, "description": "255 is the global function type" }
  }
}
