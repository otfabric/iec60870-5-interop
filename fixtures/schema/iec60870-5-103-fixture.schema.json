{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/iec60870-5-interop/fixtures/schema/iec60870-5-103-fixture.schema.json",
  "title": "iec60870-5-interop IEC 60870-5-103 fixture",
  "description": "A simulated IEC 103 protection device (the secondary station). See docs/FIXTURES.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "station", "indications"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string" },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commonAddress", "identification"],
      "properties": {
        "commonAddress": { "type": "integer", "minimum": 0, "maximum": 254 },
        "identification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fun", "col", "ascii", "software"],
          "properties": {
            "fun": { "$ref": "#/$defs/octet" },
            "col": { "$ref": "#/$defs/octet" },
            "ascii": { "type": "string", "pattern": "^[\\x20-\\x7e]{8}$" },
            "software": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
          }
        }
      }
    },
    "indications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fun", "inf", "dpi"],
        "properties": {
          "fun": { "$ref": "#/$defs/fun" },
          "inf": { "$ref": "#/$defs/octet" },
          "dpi": { "type": "integer", "minimum": 0, "maximum": 3 },
          "gi": { "type": "boolean" }
        }
      }
    },
    "measurands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fun", "inf", "type", "values"],
        "properties": {
          "fun": { "$ref": "#/$defs/fun" },
          "inf": { "$ref": "#/$defs/octet" },
          "type": { "enum": [3, 9] },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 9,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {
                "value": { "type": "integer", "minimum": -4096, "maximum": 4095 },
                "ov": { "type": "boolean" },
                "er": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fun", "inf"],
        "properties": {
          "fun": { "$ref": "#/$defs/fun" },
          "inf": { "$ref": "#/$defs/octet" }
        }
      }
    }
  },
  "$defs": {
    "octet": { "type": "integer", "minimum": 0, "maximum": 255 },
    "fun": { "type": "integer", "minimum": 0, "maximum": 254, "description": "255 is the global function type" }
  }
}
